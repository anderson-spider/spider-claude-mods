{
  "mcpServers": {
    "antigravity": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/main.mjs"],
      "env": {
        "SPIDER_ANTIGRAVITY_OPTION_FOREGROUND_MINUTES": "${user_config.foregroundMinutes}",
        "SPIDER_ANTIGRAVITY_OPTION_BACKGROUND_MINUTES": "${user_config.backgroundMinutes}",
        "SPIDER_ANTIGRAVITY_OPTION_AGY_PATH": "${user_config.agyPath}",
        "SPIDER_ANTIGRAVITY_OPTION_DEFAULT_MODEL": "${user_config.defaultModel}"
      }
    }
  }
}

{
  "modules": ["./register.tsx"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|SendMessage",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/fence/main.mjs"], "timeout": 10, "onFailure": "continue" }
        ]
      }
    ]
  }
}
